{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emdash-workshop-slides",
  // Employee Account, same as the guide
  "account_id": "d4137232cefc8f440da4a535615a3add",
  "compatibility_date": "2026-10-01",
  // Static Slidev build. Unknown paths (e.g. /12, /presenter) fall back to index.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}

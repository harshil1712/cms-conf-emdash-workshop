{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emdash-workshop-slides",
  // No account_id here: set CLOUDFLARE_ACCOUNT_ID if your login has more than one account.
  "compatibility_date": "2026-10-01",
  // Static Slidev build. Unknown paths (e.g. /12, /presenter) fall back to index.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}

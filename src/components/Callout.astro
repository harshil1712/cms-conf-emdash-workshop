---
interface Props {
  variant: "success" | "look" | "you" | "warn" | "restart" | "stage";
  title?: string;
}
const { variant, title } = Astro.props;
const iconless = variant === "success" || variant === "look" || variant === "you" || variant === "stage";
const defaultTitle: Record<string, string> = {
  you: "You do this",
  stage: "Watch the stage",
};
const label = title ?? defaultTitle[variant];
---

{
  iconless ? (
    <div class="callout" data-variant={variant} role={variant === "success" ? "note" : undefined}>
      {label && variant !== "success" && <p class="callout-title">{label}</p>}
      <slot />
    </div>
  ) : (
    <div class="callout" data-variant={variant}>
      <span class="callout-icon" aria-hidden="true">
        {variant === "restart" ? "↻" : "!"}
      </span>
      <div>
        {label && <p class="callout-heading">{label}</p>}
        <div class="callout-body">
          <slot />
        </div>
      </div>
    </div>
  )
}

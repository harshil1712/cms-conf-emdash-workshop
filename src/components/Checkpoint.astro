---
import Prompt from "./Prompt.astro";
import { inline } from "../utils/inline";

interface Props {
  letter: string;
  summary: string;
  /** Catch-up prompt text from the CMS. */
  prompt: string;
}
const { letter, summary, prompt } = Astro.props;
---

<details class="aside checkpoint">
  <summary><span><b>checkpoint-{letter.toLowerCase()}</b>Fell behind? Catch up to Checkpoint {letter}</span></summary>
  <div class="aside-body">
    <p set:html={inline(summary)} />
    <Prompt text={prompt} label="Catch-up prompt" />
  </div>
</details>

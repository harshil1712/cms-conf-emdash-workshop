---
type Scope = { name: string; note: string; on?: boolean; isNew?: boolean; danger?: boolean };
interface Props {
  scopes: Scope[];
  title?: string;
}
const { scopes, title = "Authorize this client" } = Astro.props;
---

<figure class="consent" aria-label="What to tick on your site's consent screen">
  <p class="consent-url" aria-hidden="true">your-site.workers.dev/_emdash/oauth/authorize</p>
  <div class="consent-body">
    <h4>{title}</h4>
    <p>Every box starts ticked. Keep the green ones and untick the rest. Your screen shows the wording, not the scope names.</p>
    <ul class="scopes">
      {
        scopes.map((s) => (
          <li
            class="scope"
            data-on={s.on || s.isNew ? "" : undefined}
            data-new={s.isNew ? "" : undefined}
            data-danger={s.danger ? "" : undefined}
          >
            <span class="scope-box" aria-hidden="true">
              {
                (s.on || s.isNew) && (
                  <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2.5 6.2 5 8.6l4.5-5" />
                  </svg>
                )
              }
            </span>
            <div>
              <code>{s.name}</code>
              <span class="sr-only">{s.on || s.isNew ? "(keep)" : "(clear)"}</span>
              <span>{s.note}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</figure>

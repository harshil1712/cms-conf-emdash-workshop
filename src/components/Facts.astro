---
import { inline } from "../utils/inline";

interface Props {
  items: { label: string; text: string }[];
  label?: string;
}
const { items, label = "What happens in this step" } = Astro.props;
---

<ul class="facts" aria-label={label}>
  {
    items.map((f) => (
      <li>
        <span class="facts-label">{f.label}</span>
        <span class="facts-value" set:html={inline(f.text)} />
      </li>
    ))
  }
</ul>

---
import { workshop, runOfShow } from "../data/workshop";
const W = workshop;
// Keeps "120 min" on one line.
const duration = W.duration.replace(" ", "\u00a0");
---

<div class="hero">
  <div class="hero-shell">
    <div class="hero-copy">
      <p class="eyebrow">{W.event} · {W.place} · {W.dates}</p>
      <h1 class="hero-title">{W.title}</h1>
      <p class="hero-sub">{W.subtitle}, from zero to an agent-run site.</p>
      <p class="hero-body">
        {"In two hours you'll deploy an "}<a href={W.links.docs}>EmDash</a>{" blog to "}<a href="https://developers.cloudflare.com/workers/">Cloudflare Workers</a>{", hand it to an AI agent with permissions you choose, and write a plugin that generates cover images with an API key, in a sandbox that blocks HTTP requests to unapproved hosts. Your coding agent does the typing. You make the calls."}
      </p>
      <p class="hero-meta">
        {`With ${W.speakers.slice(0, -1).join(", ")} & ${W.speakers.at(-1)} · ${duration} · `}<a href="https://astro.build/">Astro</a>{", "}<a href="https://developers.cloudflare.com/workers/">Workers</a>{", "}<a href="https://developers.cloudflare.com/d1/">D1</a>{" and "}<a href="https://developers.cloudflare.com/r2/">R2</a>
      </p>
    </div>
    <aside class="program" aria-label="Run of show">
      <p class="program-head">Run of show</p>
      <ol class="ros">
        {
          runOfShow.map((r) => (
            <li data-accent={r.accent ? "" : undefined}>
              <time>{r.time}</time>
              <span class="ros-label">{r.label}</span>
            </li>
          ))
        }
      </ol>
    </aside>
  </div>
</div>

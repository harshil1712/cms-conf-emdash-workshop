---
import { fill } from "../data/workshop";
import { inline } from "../utils/inline";

interface Props {
  /** Prompt text from the CMS. {{placeholders}} are filled in. */
  text: string;
  label?: string;
  /** Collapsed prompts show the first lines and a "Show full prompt" toggle. */
  collapsed?: boolean;
  /** Lets attendees edit the prompt in place before copying (e.g. change the topic). */
  editable?: boolean;
  hint?: string;
}
const { label, collapsed = true, editable = false, hint } = Astro.props;
const text = fill(Astro.props.text);
---

<div class="prompt" data-expanded={collapsed ? "false" : "true"}>
  <div class="prompt-bar">
    <span class="prompt-label">{label || "Copy this prompt into your agent"}</span>
    <button type="button" class="btn-copy" data-copy>Copy prompt</button>
  </div>
  <pre
    data-copy-source
    contenteditable={editable ? "true" : undefined}
    spellcheck="false"
    aria-label={editable ? "Editable prompt" : undefined}>{text}</pre>
  {
    collapsed && (
      <button type="button" class="prompt-toggle" aria-expanded="false" data-toggle>
        Show full prompt
      </button>
    )
  }
</div>
{hint && <p class="prompt-hint" set:html={inline(hint)} />}

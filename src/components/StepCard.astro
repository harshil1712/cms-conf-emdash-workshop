---
import { inline } from "../utils/inline";

interface Props {
  id: string;
  num: string;
  title: string;
  lede?: string;
  optional?: boolean;
  /** Short labels shown above the title, e.g. "You do this" or "~5 min". */
  tags?: { text: string; tone?: "accent" | "blue" }[];
  final?: boolean;
  /** Admin link, shown only to signed-in editors. */
  editUrl?: string;
}
const { id, num, title, lede, optional, tags = [], final, editUrl } = Astro.props;
const allTags = optional ? [{ text: "Optional · first to cut", tone: undefined }, ...tags] : tags;
---

<article id={id} class="stepcard" data-step={id}>
  <header class="stepcard-head">
    <p class="stepcard-eyebrow">
      <span aria-hidden="true">{final ? "Wrap-up" : `Step ${num}`}</span>
      {
        allTags.map((t) => (
          <span class="tag" data-tone={t.tone}>
            {t.text}
          </span>
        ))
      }
    </p>
    <h2 class="stepcard-title">
      <span class="sr-only">{final ? "" : `Step ${num}: `}</span>{title}
    </h2>
    {lede && <p class="stepcard-lede" set:html={inline(lede)} />}
    {editUrl && <a class="edit-link" href={editUrl}>Edit in admin</a>}
  </header>
  <div class="stepcard-body">
    <slot />
  </div>
</article>

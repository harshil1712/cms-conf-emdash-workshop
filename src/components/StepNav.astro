---
import { parts, steps } from "../data/workshop";
---

<nav class="rail" aria-label="Workshop steps" data-rail>
  <button type="button" class="rail-toggle" aria-expanded="false" data-rail-toggle>
    <span>Workshop steps</span><span aria-hidden="true">▾</span>
  </button>
  <div class="rail-list-wrap">
    <div class="rail-progress" aria-hidden="true">
      <div class="rail-progress-bar"><span data-rail-progress></span></div>
      <span data-rail-count>0 / {steps.length}</span>
    </div>
    {
      parts.map((part) => (
        <>
          <p class="rail-part">
            <a href={`#part-${part.id}`}>
              {part.label}
              {part.id !== "start" && <b>{part.name}</b>}
            </a>
            <time>{part.time}</time>
          </p>
          <ol class="rail-list">
            {steps
              .filter((s) => s.part === part.id)
              .map((s) => (
                <li class="rail-item" data-rail-item={s.id}>
                  <a href={`#${s.id}`}>
                    <span class="rail-num" aria-hidden="true">
                      {s.num}
                    </span>
                    <span>{s.label}</span>
                    {s.optional && <span class="rail-opt">opt</span>}
                  </a>
                </li>
              ))}
          </ol>
        </>
      ))
    }
  </div>
</nav>

<script>
  const items = [...document.querySelectorAll<HTMLElement>("[data-rail-item]")];
  const ids = items.map((el) => el.dataset.railItem!);
  const cards = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el);
  const bar = document.querySelector<HTMLElement>("[data-rail-progress]");
  const count = document.querySelector<HTMLElement>("[data-rail-count]");

  function setActive(id: string) {
    const idx = ids.indexOf(id);
    items.forEach((el, i) => {
      el.dataset.state = i < idx ? "done" : i === idx ? "active" : "";
      el.querySelector("a")?.toggleAttribute("aria-current", i === idx);
    });
    const pct = idx < 0 ? 0 : ((idx + 1) / ids.length) * 100;
    if (bar) bar.style.width = `${pct}%`;
    if (count) count.textContent = `${Math.max(idx + 1, 0)} / ${ids.length}`;
  }

  const visible = new Map<string, number>();
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) visible.set(e.target.id, e.boundingClientRect.top);
        else visible.delete(e.target.id);
      }
      // The topmost card in the reading band wins.
      const first = ids.find((id) => visible.has(id));
      if (first) setActive(first);
    },
    { rootMargin: "-20% 0px -55% 0px", threshold: 0 },
  );
  cards.forEach((c) => io.observe(c));

  // Mobile: collapsible rail.
  const rail = document.querySelector<HTMLElement>("[data-rail]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-rail-toggle]");
  toggle?.addEventListener("click", () => {
    const open = rail?.dataset.open === "true";
    rail!.dataset.open = String(!open);
    toggle.setAttribute("aria-expanded", String(!open));
  });
  rail?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a") && window.matchMedia("(max-width: 960px)").matches) {
      rail.dataset.open = "false";
      toggle?.setAttribute("aria-expanded", "false");
    }
  });
</script>

---
export type NavPart = { id: string; label: string; name: string; time: string; showName: boolean };
export type NavStep = { id: string; num: string; label: string; part: string; optional?: boolean };

interface Props {
  parts: NavPart[];
  steps: NavStep[];
}
const { parts, steps } = Astro.props;
---

<nav class="rail" id="rail" aria-label="Workshop steps" data-rail data-open="false">
  <p class="rail-sheet-title" aria-hidden="true">Workshop steps</p>
  {
    steps.length > 0 && (
      <div class="rail-progress" aria-hidden="true">
        <span class="rail-segs" data-rail-progress>
          {parts.map((p) => {
            const n = steps.filter((s) => s.part === p.id).length;
            return (
              n > 0 && (
                <span class="rail-seg-group" style={`flex:${n}`}>
                  {Array.from({ length: n }, () => (
                    <i data-seg />
                  ))}
                </span>
              )
            );
          })}
        </span>
        <span class="rail-count" data-rail-count>
          {steps[0]!.num} / {steps.at(-1)!.num}
        </span>
      </div>
    )
  }
  <div class="rail-groups">
    <span class="rail-indicator" aria-hidden="true" data-rail-indicator></span>
    {
      parts.map((part) => (
        <div class="rail-group">
          <p class="rail-part">
            <a href={`#part-${part.id}`}>
              <span>{part.label}</span>
              {part.showName && <b>{part.name}</b>}
            </a>
            <time>{part.time}</time>
          </p>
          <ol class="rail-list">
            {steps
              .filter((s) => s.part === part.id)
              .map((s) => (
                <li class="rail-item" data-rail-item={s.id} data-rail-num={s.num}>
                  <a href={`#${s.id}`}>
                    <span class="rail-num" aria-hidden="true">
                      {s.num}
                    </span>
                    <span class="rail-label">{s.label}</span>
                    {s.optional && <span class="rail-opt">opt</span>}
                  </a>
                </li>
              ))}
          </ol>
        </div>
      ))
    }
  </div>
</nav>
<div class="rail-scrim" data-rail-scrim></div>

<script>
  import "../scripts/rail";
</script>

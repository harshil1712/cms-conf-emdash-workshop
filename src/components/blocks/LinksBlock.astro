---
import type { BlockComponentProps } from "emdash/ui";
import type { StepBodyLinksBlock } from "../../../emdash-env";
import Icon from "../Icon.astro";
import { fill } from "../../data/workshop";

type Props = BlockComponentProps<StepBodyLinksBlock>;
const { value } = Astro.props;
---

<div class="links-grid">
  {
    (value.items ?? []).map((l) => (
      <a class="link-card" href={fill(l.url)}>
        <b class="link-title">{l.title}</b>
        {l.text && <span class="link-text">{l.text}</span>}
        <Icon name="arrow-up-right" size="sm" class="link-arrow" />
      </a>
    ))
  }
</div>

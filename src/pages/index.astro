---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import StepNav, { type NavPart, type NavStep } from "../components/StepNav.astro";
import PartHeader from "../components/PartHeader.astro";
import StepCard from "../components/StepCard.astro";
import GuideBlocks from "../components/GuideBlocks.astro";
import { workshop as W, repoUrl, fill } from "../data/workshop";

// The guide's content lives in EmDash: `parts` and `steps`, ordered by `position`.
// Each has a `body` blocks field (prompts, callouts, comparisons, …), rendered by GuideBlocks.
const [partsResult, stepsResult] = await Promise.all([
  getEmDashCollection("parts", { orderBy: { position: "asc" }, limit: 50 }),
  getEmDashCollection("steps", { orderBy: { position: "asc" }, limit: 100 }),
]);
if (Astro.cache?.enabled) {
  Astro.cache.set(partsResult.cacheHint);
  Astro.cache.set(stepsResult.cacheHint);
}
const parts = partsResult.entries;
const steps = stepsResult.entries;

// Editors signed in to the admin get an "Edit in admin" link on every card.
const canEdit = Boolean(Astro.locals.user);
const editUrl = (collection: string, id: string) => (canEdit ? `/_emdash/admin/content/${collection}/${id}` : undefined);

const navParts: NavPart[] = parts.map((p, i) => ({
  id: p.id,
  label: p.data.rail_label || p.data.label,
  name: p.data.title,
  time: p.data.time.split("–")[0]!.trim(),
  showName: i > 0,
}));
const navSteps: NavStep[] = steps
  .filter((s) => s.data.part)
  .map((s) => ({ id: s.id, num: s.data.num, label: s.data.label, part: s.data.part!, optional: s.data.optional }));

const stepsIn = (part: string) => steps.filter((s) => s.data.part === part);
const unparted = steps.filter((s) => !s.data.part);
---

<Base
  title={`${W.title} · ${W.subtitle}`}
  description="Deploy an EmDash blog to Cloudflare, let an AI agent run it with scopes you choose, and build a sandboxed plugin that generates cover images without leaking its API key."
>
  <Hero />

  <div class="page-shell">
    <StepNav parts={navParts} steps={navSteps} />

    <main class="page-main" id="main">
      <section class="intro" aria-labelledby="leave-title">
        <h2 class="kicker" id="leave-title">What you'll leave with</h2>
        <ol class="leave-list">
          <li>A live EmDash blog on Cloudflare Workers, D1 and R2, with a content model you changed yourself.</li>
          <li>An AI agent connected to your site over MCP, with scopes you chose, that has drafted, tagged and scheduled real posts.</li>
          <li>
            A <strong>Cover Images</strong> plugin you wrote. Editors and agents both use it, it blocks posts without a
            cover, and it holds a Replicate token its manifest only lets it send to Replicate, and the sandbox enforces it.
          </li>
        </ol>
      </section>

      {
        parts.length === 0 && (
          <p class="empty">
            No content yet. Sign in to the <a href="/_emdash/admin">admin</a> to finish setup: the guide's content is
            in the seed.
          </p>
        )
      }

      {
        parts.map((part) => (
          <>
            {part.data.break_before && (
              <div class="break" role="separator">
                <span>
                  <b>Break</b>
                  {fill(part.data.break_before)}
                </span>
              </div>
            )}
            <PartHeader
              id={`part-${part.id}`}
              label={part.data.label}
              name={part.data.title}
              time={part.data.time}
              lede={part.data.lede ?? ""}
              concepts={part.data.concepts ?? []}
              editUrl={editUrl("parts", part.data.id)}
            >
              <GuideBlocks value={part.data.body} />
            </PartHeader>
            {stepsIn(part.id).map((s) => (
              <StepCard
                id={s.id}
                num={s.data.num}
                title={fill(s.data.title)}
                lede={s.data.lede}
                optional={s.data.optional}
                tags={s.data.tag ? [{ text: s.data.tag, tone: "blue" }] : []}
                final={s.data.final}
                editUrl={editUrl("steps", s.data.id)}
              >
                <GuideBlocks value={s.data.body} />
              </StepCard>
            ))}
          </>
        ))
      }

      {
        unparted.map((s) => (
          <StepCard
            id={s.id}
            num={s.data.num}
            title={fill(s.data.title)}
            lede={s.data.lede}
            optional={s.data.optional}
            tags={s.data.tag ? [{ text: s.data.tag, tone: "blue" }] : []}
            final={s.data.final}
            editUrl={editUrl("steps", s.data.id)}
          >
            <GuideBlocks value={s.data.body} />
          </StepCard>
        ))
      }
    </main>
  </div>

  <footer class="footer">
    <span>{W.title}</span><span class="sep">·</span><span>{W.event}</span><span class="sep">·</span>
    <a href={W.links.docs}>EmDash docs</a>
    <span class="sep">·</span>
    <a href={repoUrl}>Workshop repo</a>
    <span class="sep">·</span>
    <a href={W.links.announcement}>EmDash 1.0</a>
  </footer>
</Base>

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emdash-workshop",
  // No account_id here: set CLOUDFLARE_ACCOUNT_ID if your login has more than one account.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "emdash-workshop" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "emdash-workshop-media" }],
  // General maintenance cron trigger (scheduled publishing, cleanup)
  "triggers": { "crons": ["* * * * *"] }
}

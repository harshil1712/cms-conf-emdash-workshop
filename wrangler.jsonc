{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emdash-workshop",
  // Employee Account. Pinned so a deploy never asks which account to use.
  "account_id": "d4137232cefc8f440da4a535615a3add",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "emdash-workshop" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "emdash-workshop-media" }],
  // General maintenance cron trigger (scheduled publishing, cleanup)
  "triggers": { "crons": ["* * * * *"] }
}
